# =====================================================================
# VARIABLES DE ENTORNO — NextCommerce (MySQL)
# Copia este archivo a `.env` y completa los valores (o usa DATABASE_URL)
# =====================================================================

# --- Clave secreta para firmar/verificar los JWT (¡cámbiala en producción!) ---
AUTH_SECRET=genera-una-clave-larga-y-segura

# --- Opción A: URL completa de conexión a MySQL ---
# Formato: mysql://usuario:clave@host:puerto/nombre_bd
# Agrega ?ssl=true si el proveedor lo requiere (p. ej. PlanetScale, Aiven, Railway)
DATABASE_URL=mysql://usuario:clave@localhost:3306/nextcommerce

# --- Opción B: credenciales por separado (alternativa a DATABASE_URL) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=tu_clave
# DB_NAME=nextcommerce
# DB_SSL=true

# --- Pool de conexiones (opcional) ---
# DB_POOL_LIMIT=5
